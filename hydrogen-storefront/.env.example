PUBLIC_STORE_DOMAIN=mock.shop
# The sample catalog is the default. Set MERRIVY_LIVE=true only when the real store opens.
MERRIVY_LIVE=
MERRIVY_DEMO=true
# Generate a unique random value locally. Never commit the real value.
SESSION_SECRET=replace-with-a-random-local-secret

# Help chat. Paste real values only into your local .env and into Shopify
# Oxygen's environment variables, never here. See store/HELP-CHAT-SETUP.md
# in the workspace.
# OpenRouter API key (server only). With it set, the chat is live.
OPENROUTER_API_KEY=
# Optional kill switch: "off" hides the chat even with a key.
MERRIVY_CHAT=
# Order tracking: a Shopify Admin API token with read_orders only.
SHOPIFY_ADMIN_ORDERS_TOKEN=
# The store's myshopify.com domain, e.g. ndfdtc-br.myshopify.com.
SHOPIFY_ADMIN_STORE_DOMAIN=
